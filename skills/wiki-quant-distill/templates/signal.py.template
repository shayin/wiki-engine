            df: OHLCV 日线，要求列 open/high/low/close/volume，DatetimeIndex

        Returns:
            SignalResult（value ∈ [-1, +1]）
        """
        # 1. 数据完整性检查
        if df is None or len(df) < self.lookback:
            return self._neutral(ticker, "数据不足")

        required = ["open", "high", "low", "close", "volume"]
        missing = [c for c in required if c not in df.columns]
        if missing:
            return self._neutral(ticker, f"缺列 {missing}")

        df = df.dropna(subset=required).tail(self.lookback)
        if len(df) < self.lookback // 2:
            return self._neutral(ticker, "有效数据不足")

        # 2. 核心算法（TODO: 按 SKILL.md 的 E 段实现）
        sub_scores = {}
        try:
            sub_scores = self._compute_subscores(df)
        except Exception as e:
            log.warning(f"[{ticker}] {self.name} 算法异常: {e}")
            return self._neutral(ticker, f"算法异常: {e}")

        # 3. 汇总 score → value（[-1, +1]）
        value = self._aggregate(sub_scores)

        # 4. 构造 details（人类可读字段必须中文化）
        details = {
            "pattern_type": "{{PATTERN_TYPE_DEFAULT}}",
            "score_breakdown": sub_scores,
            {{ADDITIONAL_DETAILS}}
        }

        # 5. reasons 列表
        reasons = self._build_reasons(sub_scores)

        return SignalResult(
            ticker=ticker,
            signal_name=self.name,
            value=float(np.clip(value, -1.0, 1.0)),
            passed=value >= self.threshold,
            details=details,
            reasons=reasons,
        ).clamp()

